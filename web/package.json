{
  "name": "coverage-exchange-web",
  "version": "0.3.0",
  "private": true,
  "description": "Coverage Exchange UI. Reads Creditcoin CC3 testnet directly; every claimed number is generated from the repo's evidence manifest.",
  "scripts": {
    "gen:evidence": "node scripts/gen-evidence.mjs",
    "predev": "npm run gen:evidence",
    "dev": "next dev",
    "prebuild": "npm run gen:evidence",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "check:evidence": "node scripts/gen-evidence.mjs && git diff --exit-code -- lib/evidence.generated.ts"
  },
  "dependencies": {
    "gsap": "^3.13.0",
    "lenis": "^1.3.8",
    "next": "^15.5.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "viem": "^2.37.3"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "typescript": "^5.9.2"
  }
}
