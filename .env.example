# Environment for Coverage Exchange.
# Copy to .env and fill in. NEVER commit .env (it is gitignored) and never commit a private key.

# --- networks ---------------------------------------------------------------------------------
CC3_TESTNET_RPC_URL=https://rpc.cc3-testnet.creditcoin.network
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
PROOF_BUILDER=https://prover.cc3-testnet.creditcoin.network
CHAIN_KEY=1

# --- deployment (only needed to deploy / verify) ----------------------------------------------
# A funded CC3 testnet key. Testnet only; this contract set is never deployed to mainnet.
DEPLOYER_PRIVATE_KEY=
CC3_EXPLORER_API_KEY=

# --- deployment verification (read from the chain, never trusted from config) ------------------
ENGINE_ADDRESS=
ADAPTER_ADDRESS=

# --- challenger watcher ------------------------------------------------------------------------
CHALLENGE_MANAGER=
COVERAGE_IDS=
# Leave empty to run the watcher in DRY RUN: it previews challenges and submits nothing.
CHALLENGER_PRIVATE_KEY=
POLL_SECONDS=60
